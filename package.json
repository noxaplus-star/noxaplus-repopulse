{
  "name": "noxaplus-repopulse",
  "version": "1.0.0",
  "description": "Audit GitHub repository health with a 0-100 score, an actionable HTML report, and a shareable badge. Built by NoxaPlus.",
  "keywords": [
    "github",
    "repository",
    "audit",
    "health-check",
    "cli",
    "open-source",
    "maintenance",
    "noxaplus"
  ],
  "author": "NoxaPlus <NoxaPlus2025@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/noxaplus-star/noxaplus-repopulse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noxaplus-star/noxaplus-repopulse.git"
  },
  "bugs": {
    "url": "https://github.com/noxaplus-star/noxaplus-repopulse/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "repopulse": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs/report.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-site.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:demo": "node dist/cli.js audit --demo --out repopulse-demo.html",
    "site": "node scripts/build-site.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
